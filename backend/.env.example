# Copy to `.env` and fill in. Never commit `.env`.

# "local" enables developer conveniences (OTP codes echoed in responses).
# Anything else enforces production guards at startup.
ENV=local

DATABASE_URL=postgresql://lifesearch:lifesearch@localhost:5432/lifesearch
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME

ACCOUNT_TOKEN_TTL_MINUTES=43200
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DEVICE_CHALLENGE_TTL_SECONDS=120

# Envelope-encrypts sector keys at rest (app/security/envelope.py). Must
# decode to exactly 32 bytes. Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SECTOR_KEY_WRAP_SECRET=CHANGE_ME

BATTERY_WARN_THRESHOLD_PCT=30
BATTERY_BLOCK_THRESHOLD_PCT=15
